generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String           @id @default(uuid())
  studentId        String           @unique
  name             String
  email            String           @unique
  passwordHash     String
  role             Role             @default(STUDENT)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  batchId          String?
  college          String?
  degree           String?
  domainId         String?
  graduationYear   Int?
  phone            String?
  specializationId String?
  reviewsGiven     Review[]
  courses          StudentCourse[]
  studentProjects  StudentProject[]
}

model Course {
  id          String          @id @default(uuid())
  key         String          @unique
  name        String
  description String
  duration    String
  skills      String[]
  image       String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  projects    Project[]
  students    StudentCourse[]
}

model StudentCourse {
  id        String   @id @default(uuid())
  studentId String
  courseId  String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  link        String?
  date        DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Reusable internship project template created by an admin.
model Project {
  id          String           @id @default(uuid())
  title       String
  description String
  /// Optional link to a Course for organizational/filtering purposes only.
  courseId    String?
  status      ProjectStatus    @default(DRAFT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  /// Optional link to external resources like a Notion workflow or project details.
  projectLink String?
  course      Course?          @relation(fields: [courseId], references: [id])
  phases      ProjectPhase[]
  assignments StudentProject[]

  @@index([courseId])
  @@index([status])
}

/// An ordered phase/stage within a Project template.
model ProjectPhase {
  id            String                @id @default(uuid())
  projectId     String
  title         String
  description   String
  instructions  String
  phaseOrder    Int
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  studentPhases StudentProjectPhase[]
  topics        ProjectPhaseTopic[]

  @@unique([projectId, phaseOrder])
  @@index([projectId])
}

/// A specific topic/module within a ProjectPhase.
model ProjectPhaseTopic {
  id             String       @id @default(uuid())
  projectPhaseId String
  title          String
  description    String?
  blogUrl        String
  order          Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  phase          ProjectPhase @relation(fields: [projectPhaseId], references: [id], onDelete: Cascade)

  @@unique([projectPhaseId, order])
  @@index([projectPhaseId])
}

/// The assignment of a Project to a specific Student.
model StudentProject {
  id          String                @id @default(uuid())
  studentId   String
  projectId   String
  status      StudentProjectStatus  @default(ASSIGNED)
  assignedAt  DateTime              @default(now())
  dueDate     DateTime?
  completedAt DateTime?
  certificate Certificate?
  project     Project               @relation(fields: [projectId], references: [id])
  student     User                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  phases      StudentProjectPhase[]

  @@unique([studentId, projectId])
  @@index([studentId])
  @@index([projectId])
  @@index([status])
}

/// Persistent per-student, per-phase progress state.
/// Created at assignment time — source of truth for workflow position.
model StudentProjectPhase {
  id               String         @id @default(uuid())
  studentProjectId String
  phaseId          String
  status           PhaseStatus    @default(LOCKED)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  phase            ProjectPhase   @relation(fields: [phaseId], references: [id])
  studentProject   StudentProject @relation(fields: [studentProjectId], references: [id], onDelete: Cascade)
  submissions      Submission[]

  @@unique([studentProjectId, phaseId])
  @@index([studentProjectId])
  @@index([status])
}

/// A student's submitted work for a phase. Multiple submissions per phase are allowed
/// to preserve full resubmission history.
model Submission {
  id                    String              @id @default(uuid())
  studentProjectPhaseId String
  content               String
  repoUrl               String?
  liveUrl               String?
  status                SubmissionStatus    @default(SUBMITTED)
  submittedAt           DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  automatedReviews      AutomatedReview[]
  reviews               Review[]
  studentProjectPhase   StudentProjectPhase @relation(fields: [studentProjectPhaseId], references: [id], onDelete: Cascade)

  @@index([studentProjectPhaseId])
  @@index([status])
}

/// Admin/Mentor review of a single Submission. Auditable — never overwritten.
model Review {
  id           String         @id @default(uuid())
  submissionId String
  reviewerId   String
  decision     ReviewDecision
  feedback     String
  reviewedAt   DateTime       @default(now())
  score        Int?
  reviewer     User           @relation(fields: [reviewerId], references: [id])
  submission   Submission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([reviewerId])
}

model Domain {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  batches         Batch[]
  curricula       Curriculum[]
  specializations Specialization[]
}

model Specialization {
  id          String       @id @default(uuid())
  domainId    String
  name        String
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  batches     Batch[]
  curricula   Curriculum[]
  domain      Domain       @relation(fields: [domainId], references: [id])

  @@unique([domainId, name])
}

model Batch {
  id                  String                        @id @default(uuid())
  name                String                        @unique
  domainId            String
  specializationId    String?
  curriculumVersionId String?
  status              BatchStatus
  startDate           DateTime
  durationWeeks       Int
  description         String?
  isActive            Boolean                       @default(true)
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  curriculumVersion   CurriculumVersion?            @relation(fields: [curriculumVersionId], references: [id])
  domain              Domain                        @relation(fields: [domainId], references: [id])
  specialization      Specialization?               @relation(fields: [specializationId], references: [id])
  enrollments         StudentCurriculumEnrollment[]
}

model Curriculum {
  id               String              @id @default(uuid())
  domainId         String
  specializationId String?
  name             String
  description      String?
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  domain           Domain              @relation(fields: [domainId], references: [id])
  specialization   Specialization?     @relation(fields: [specializationId], references: [id])
  versions         CurriculumVersion[]
}

model CurriculumVersion {
  id           String                        @id @default(uuid())
  curriculumId String
  version      String
  status       CurriculumStatus
  publishedAt  DateTime?
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt
  batches      Batch[]
  phases       CurriculumPhase[]
  curriculum   Curriculum                    @relation(fields: [curriculumId], references: [id])
  enrollments  StudentCurriculumEnrollment[]
}

model CurriculumPhase {
  id                  String                 @id @default(uuid())
  curriculumVersionId String
  phaseNumber         Int
  title               String
  description         String
  objectives          String?
  durationDays        Int                    @default(7)
  phaseType           CurriculumPhaseType    @default(NORMAL)
  googleSheetUrl      String?
  sheetVisibleFrom    DateTime?
  requiresGitHub      Boolean                @default(true)
  requiresLiveDemo    Boolean                @default(false)
  projectId           String?
  isPublished         Boolean                @default(true)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  curriculumVersion   CurriculumVersion      @relation(fields: [curriculumVersionId], references: [id])
  resources           PhaseResource[]
  tasks               PhaseTask[]
  studentProgress     StudentPhaseProgress[]

  @@unique([curriculumVersionId, phaseNumber])
}

model PhaseResource {
  id                String          @id @default(uuid())
  curriculumPhaseId String
  title             String
  type              ResourceType
  url               String
  description       String?
  order             Int             @default(0)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  curriculumPhase   CurriculumPhase @relation(fields: [curriculumPhaseId], references: [id], onDelete: Cascade)
}

model PhaseTask {
  id                String          @id @default(uuid())
  curriculumPhaseId String
  title             String
  description       String
  instructions      String?
  order             Int             @default(0)
  isRequired        Boolean         @default(true)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  curriculumPhase   CurriculumPhase @relation(fields: [curriculumPhaseId], references: [id], onDelete: Cascade)
  studentTasks      StudentTask[]
}

model StudentCurriculumEnrollment {
  id                  String                 @id @default(uuid())
  studentId           String
  batchId             String?
  curriculumVersionId String
  startDate           DateTime
  status              InternshipStatus
  completedAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  batch               Batch?                 @relation(fields: [batchId], references: [id])
  curriculumVersion   CurriculumVersion      @relation(fields: [curriculumVersionId], references: [id])
  phaseProgress       StudentPhaseProgress[]

  @@unique([studentId, curriculumVersionId])
}

model StudentPhaseProgress {
  id           String                      @id @default(uuid())
  enrollmentId String
  phaseId      String
  status       PhaseStatus
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  enrollment   StudentCurriculumEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  phase        CurriculumPhase             @relation(fields: [phaseId], references: [id])
  studentTasks StudentTask[]

  @@unique([enrollmentId, phaseId])
}

model StudentTask {
  id          String               @id @default(uuid())
  progressId  String
  taskId      String
  completedAt DateTime?
  isCompleted Boolean              @default(false)
  progress    StudentPhaseProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)
  task        PhaseTask            @relation(fields: [taskId], references: [id])

  @@unique([progressId, taskId])
}

model Application {
  id               String            @id @default(uuid())
  name             String
  email            String
  phone            String?
  college          String?
  degree           String?
  graduationYear   Int?
  domainId         String?
  specializationId String?
  resumeUrl        String?
  message          String?
  status           ApplicationStatus
  reviewedBy       String?
  reviewedAt       DateTime?
  reviewNotes      String?
  createdUserId    String?
  appliedAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  interviews       Interview[]
}

model Interview {
  id                 String           @id @default(uuid())
  scheduledAt        DateTime?
  meetingLink        String?
  interviewerId      String?
  status             InterviewStatus
  technicalScore     Int?
  projectScore       Int?
  communicationScore Int?
  overallScore       Int?
  feedback           String?
  result             InterviewResult?
  retakeOf           String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  applicationId      String
  application        Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Certificate {
  id                String            @id @default(uuid())
  studentId         String
  certificateNo     String            @unique
  verificationToken String            @unique
  domain            String
  specialization    String?
  startDate         DateTime
  endDate           DateTime
  issuedAt          DateTime          @default(now())
  status            CertificateStatus
  revokedAt         DateTime?
  revokeReason      String?
  studentProjectId  String            @unique
  studentProject    StudentProject    @relation(fields: [studentProjectId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())
}

model ActivityLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
}

model AutomatedReview {
  id             String                @id @default(uuid())
  submissionId   String
  summary        String?
  detectedIssues Json?
  suggestions    Json?
  score          Int?
  status         AutomatedReviewStatus @default(PENDING)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  submission     Submission            @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

enum Role {
  STUDENT
  MENTOR
  ADMIN
  SUPER_ADMIN
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum StudentProjectStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PhaseStatus {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  SUBMITTED
  CHANGES_REQUESTED
  COMPLETED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum ReviewDecision {
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum BatchStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum CurriculumStatus {
  DRAFT
  PREVIEW
  PUBLISHED
  ARCHIVED
}

enum CurriculumPhaseType {
  NORMAL
  MIDTERM
  FINAL
}

enum ResourceType {
  VIDEO
  PDF
  ARTICLE
  LINK
  OTHER
}

enum InternshipStatus {
  ACTIVE
  COMPLETED
  SUSPENDED
  WITHDRAWN
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  SHORTLISTED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InterviewResult {
  PENDING
  SELECTED
  REJECTED
  ON_HOLD
}

enum CertificateStatus {
  ACTIVE
  REVOKED
  REISSUED
}

enum CertificateEligibility {
  NOT_ELIGIBLE
  ELIGIBLE
  ISSUED
  REVOKED
}

enum AutomatedReviewStatus {
  PENDING
  COMPLETED
  FAILED
}
